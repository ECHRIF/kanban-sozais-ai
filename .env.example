# ─── Base de données MySQL ───────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=kanban_sozais

# ─── API Anthropic (Claude) ──────────────────────────────────────
# Obtenez votre clé sur https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ─── Serveur ─────────────────────────────────────────────────────
PORT=3001

# ─── Sécurité (IMPORTANT) ────────────────────────────────────────
# Secret de signature des sessions JWT. Sans lui, un fallback stable est
# utilisé, mais définissez une valeur aléatoire en production
# (générer avec : openssl rand -hex 64). Sur Railway : onglet "Variables".
JWT_SECRET=changez_moi_valeur_aleatoire_longue

# ─── Email (optionnel — pour les rapports hebdomadaires) ─────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# REPORT_TO=manager@sozais.com
